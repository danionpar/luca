    "test:watch": "node --import tsx --test --watch \"src/**/*.test.ts\""
  },
  "dependencies": {
    "dotenv": "16.4.7",
    "drizzle-orm": "0.39.3",
    "pdfjs-dist": "4.9.155",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.13.5",
    "drizzle-kit": "0.30.5",
    "tsx": "4.19.3",
    "typescript": "5.7.3"
  }
}
